{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main RelayCat window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "dialog:default",
    "clipboard-manager:allow-write-image",
    "updater:default",
    "process:default",
    "autostart:default"
  ]
}
