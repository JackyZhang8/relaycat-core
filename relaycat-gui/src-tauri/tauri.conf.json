{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayCat",
  "version": "0.1.5",
  "identifier": "ai.relaycat.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RelayCat",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://www.relaycat.cn/update/gui.json",
        "https://relaycat.dev/update/gui.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NDEwRUVEODc0Njg4RkYKUldUL2lFYUg3UTVCNUhCUHJWbXBtKzNvQWp1Qi9rdjlEVG1MMGFOUUdXSExCcjRrUkRFbWFGeXEK"
    }
  }
}
